{
    "$schema": "./vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "phpUnit": {
        "configDir": ".infection"
    },
    "timeout": 10,
    "tmpDir": "build/infection/container-tmp",
    "logs": {
        "summary": "build/infection/container-summary.log",
        "json": "build/infection/container-report.json"
    },
    "mutators": {
        "@default": true
    }
}
