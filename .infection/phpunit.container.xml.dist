<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         cacheDirectory="../build/phpunit-infection-container">
    <source>
        <include>
            <file>../src/Container/Container.php</file>
        </include>
    </source>
    <testsuites>
        <testsuite name="Lemonade Framework Container Unit">
            <directory>../tests/Unit/Container</directory>
        </testsuite>
        <testsuite name="Lemonade Framework Container Property">
            <directory>../tests/Property/Container</directory>
        </testsuite>
    </testsuites>
</phpunit>
