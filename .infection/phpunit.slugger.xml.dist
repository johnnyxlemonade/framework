<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         cacheDirectory="../build/phpunit-infection-slugger">
    <source>
        <include>
            <file>../src/Support/Slug/Slugger.php</file>
        </include>
    </source>
    <testsuites>
        <testsuite name="Lemonade Framework Slugger Unit">
            <file>../tests/Unit/Support/Slug/SluggerTest.php</file>
        </testsuite>
        <testsuite name="Lemonade Framework Slugger Property">
            <file>../tests/Property/Support/Slug/SluggerPropertiesTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
